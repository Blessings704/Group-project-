<?xml version="1.0" encoding="utf-8"?>
<!-- Leah Lusinje, Oscar: ScrollView container for the detail screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- LinearLayout holding our detail text fields and action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TextView showing the expense title heading -->
        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="90dp"
            android:text="@string/detail_screen_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- TextView showing the selected expense category -->
        <TextView
            android:id="@+id/detailCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textSize="18sp" />

        <!-- TextView showing the formatted expense amount -->
        <TextView
            android:id="@+id/detailAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textSize="18sp" />

        <!-- TextView showing optional description notes -->
        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textSize="16sp" />

        <!-- TextView showing whether the expense was marked essential -->
        <TextView
            android:id="@+id/detailEssential"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textSize="16sp" />

        <!-- Button that triggers the share intent chooser -->
        <Button
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_button" />

        <!-- Button that marks the expense as reviewed and returns result OK -->
        <Button
            android:id="@+id/reviewButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/review_button" />

        <!-- Button that cancels and goes back without review -->
        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/back_button" />

    </LinearLayout>

</ScrollView>
