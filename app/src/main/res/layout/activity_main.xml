<?xml version="1.0" encoding="utf-8"?>
<!--  scroll in landscape to avoid cutting off the screen -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <EditText
            android:id="@+id/descriptionInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/description_hint"
            android:inputType="text"
            android:minHeight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/noteInput"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:autofillHints=""
            android:gravity="top|start"
            android:hint="@string/note_hint"
            android:inputType="textMultiLine"
            android:textColorHint="#546E7A"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/descriptionInput" />

        <EditText
            android:id="@+id/amountInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:autofillHints=""
            android:hint="@string/amount_hint"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            app:layout_constraintEnd_toStartOf="@id/saveButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/noteInput"
            tools:ignore="VisualLintTextFieldSize" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_button"
            app:layout_constraintTop_toTopOf="@id/amountInput"
            app:layout_constraintBottom_toBottomOf="@id/amountInput"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/amountInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===== LAB 2: category, Essential switch, Recurring checkbox ===== -->

        <!-- RadioGroup: only ONE category can be picked at a time -->
        <RadioGroup
            android:id="@+id/categoryGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/statusText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Food is ticked by default -->
            <RadioButton
                android:id="@+id/radioFood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/category_food" />

            <RadioButton
                android:id="@+id/radioTransport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_transport" />

            <RadioButton
                android:id="@+id/radioBooks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_books" />

            <RadioButton
                android:id="@+id/radioOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_other" />
        </RadioGroup>

        <!-- Switch: on = essential expense, off = not essential -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/essentialSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/essential_label"
            app:layout_constraintTop_toBottomOf="@id/categoryGroup"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Checkbox: ticked = this expense repeats every month -->
        <CheckBox
            android:id="@+id/recurringCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recurring_label"
            app:layout_constraintTop_toBottomOf="@id/essentialSwitch"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>