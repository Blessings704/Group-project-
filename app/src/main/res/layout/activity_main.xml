<?xml version="1.0" encoding="utf-8"?>
<!-- Fyaupi Mwenelupembe, Rita Makanjira: NestedScrollView container that lets users scroll smoothly through the whole screen -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Fyaupi Mwenelupembe, Rita Makanjira: ConstraintLayout holding all our entry form input fields and lists -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Fyaupi Mwenelupembe, Rita Makanjira: EditText where user types what the expense was for -->
        <EditText
            android:id="@+id/descriptionInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/description_hint"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:autofillHints=""
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fyaupi Mwenelupembe, Rita Makanjira: EditText for optional multi-line notes -->
        <EditText
            android:id="@+id/noteInput"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:hint="@string/note_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top|start"
            android:autofillHints=""
            app:layout_constraintTop_toBottomOf="@id/descriptionInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fyaupi Mwenelupembe, Rita Makanjira: EditText for entering the numeric expense amount -->
        <EditText
            android:id="@+id/amountInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:hint="@string/amount_hint"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:autofillHints=""
            app:layout_constraintTop_toBottomOf="@id/noteInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/saveButton"
            tools:ignore="VisualLintTextFieldSize" />

        <!-- Fyaupi Mwenelupembe, Rita Makanjira: Button that triggers validation and saves the expense -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_button"
            app:layout_constraintTop_toTopOf="@id/amountInput"
            app:layout_constraintBottom_toBottomOf="@id/amountInput"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fyaupi Mwenelupembe, Rita Makanjira: TextView showing status feedback and success summaries -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/amountInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Blessings, Trevor: TextView displaying the total spent during the current session -->
        <TextView
            android:id="@+id/sessionTotalText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/session_total_initial"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/statusText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fyaupi Mwenelupembe, Rita Makanjira: RadioGroup for selecting the expense category -->
        <RadioGroup
            android:id="@+id/categoryGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/sessionTotalText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/radioFood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/category_food" />

            <RadioButton
                android:id="@+id/radioTransport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_transport" />

            <RadioButton
                android:id="@+id/radioBooks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_books" />

            <RadioButton
                android:id="@+id/radioOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_other" />

        </RadioGroup>

        <!-- Fyaupi Mwenelupembe, Rita Makanjira: MaterialSwitch to mark an expense as essential -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/essentialSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/essential_label"
            app:layout_constraintTop_toBottomOf="@id/categoryGroup"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Fyaupi Mwenelupembe, Rita Makanjira: Checkbox to mark an expense as recurring monthly -->
        <CheckBox
            android:id="@+id/recurringCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recurring_label"
            app:layout_constraintTop_toBottomOf="@id/essentialSwitch"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- harrybanda200, PfabyGo: TextView displaying the persistent all-time sum total from Room database -->
        <TextView
            android:id="@+id/allTimeTotalText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/all_time_total_initial"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/recurringCheckbox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- RTGONDWE, Jubie: RecyclerView displaying our saved expense list cards -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/expenseList"
            android:layout_width="0dp"
            android:layout_height="500dp"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/allTimeTotalText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
